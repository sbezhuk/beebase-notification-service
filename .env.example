APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080

POSTGRES_USER=beebase
POSTGRES_NOTIFICATION_PASSWORD=beebase
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=beebase_notification
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_NOTIFICATION_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Firebase Admin SDK. The JSON is base64-encoded so dotenv and Compose env_file
# parsing cannot alter quotes, newlines, or private-key escapes.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Apple/APNs-compatible configuration reserved for the future delivery path.
APPLE_BUNDLE_ID=com.beebase.production
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox

AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
REDIS_ADDR=localhost:6379
REDIS_CONNECT_TIMEOUT=5s
